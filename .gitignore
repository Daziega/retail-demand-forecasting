retail_forecasting_env/

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Node
node_modules/

# OS / editor
.DS_Store
*.swp
~$*

# Editing backups (intermediate snapshots, not deliverables)
*.docx.bak*

# Secrets
.env

# Data inputs (raw Kaggle dataset — not redistributed; see data/raw/README.md
