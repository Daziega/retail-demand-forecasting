# Trained models (artefacts, not source)
models/

# Large intermediate artefacts (regeneratable from notebooks)
artifacts/

# Large preprocessing outputs (regeneratable; the 10MB stratified subsample IS committed)
data/processed/feature_engineered_data.parquet
data/processed/preprocessed_data.parquet

# Demo-mode simulation output (regeneratable: python src/inventory_simulation.py --demo)
data/processed/simulation_results_demo.csv
